@model TestServer.Models.VNPAY.PaymentResponseModel // Hoặc model tương ứng

@{
    // Lấy thông tin từ Controller
    var message = ViewBag.ResultMessage as string ?? "Không xác định trạng thái giao dịch.";
    var isSuccess = Model?.Success ?? false;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kết Quả Thanh Toán</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Be Vietnam Pro', sans-serif;
            background-color: #f4f7f6;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            text-align: center;
        }
        .container {
            background-color: #fff;
            border-radius: 8px;
            padding: 40px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            max-width: 400px;
            width: 100%;
        }
        .message {
            font-size: 1.5em; /* Kích thước chữ to hơn */
            font-weight: 600;
            margin-bottom: 30px;
        }
        .message-success {
            color: #27AE60; /* Màu xanh lá */
        }
        .message-fail {
            color: #EB5757; /* Màu đỏ */
        }
        .button {
            display: inline-block;
            background-color: #2F80ED; /* Màu xanh dương */
            color: white;
            padding: 12px 30px;
            border-radius: 5px;
            text-decoration: none;
            font-weight: 600;
            transition: background-color 0.3s ease;
        }
        .button:hover {
            background-color: #2567b8;
        }
    </style>
</head>
<body>
    <div class="container">
        @if (isSuccess)
        {
            <p class="message message-success">Thanh toán thành công!</p>
        }
        else
        {
            // Hiển thị thông báo lỗi/hủy cụ thể từ ViewBag
            <p class="message message-fail">@message</p>
        }

        <a href="/" class="button">Quay về trang chủ</a>
    </div>
</body>
</html>